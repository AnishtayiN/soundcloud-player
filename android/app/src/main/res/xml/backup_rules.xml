<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6–11 (auto backup). Backups are disabled with allowBackup="false"; these rules are a second line of
     defence: never back up the WebView storage (localStorage holds the login token sc_token), IndexedDB (offline
     songs), cookies, caches or downloaded updates. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
